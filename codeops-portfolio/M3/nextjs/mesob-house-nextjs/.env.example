# Public site URL — used for metadata, sitemap and Open Graph links.
# In production this must be the public HTTPS origin, not localhost.
NEXT_PUBLIC_SITE_URL=

# Origin used as an additional same-origin check for mutations.
# In production this must match the URL users open, not localhost.
APP_ORIGIN=

REVALIDATE_SECRET=

# Postgres (Neon, Supabase or Vercel Postgres). Required: the app has no file
# fallback. POSTGRES_URL / POSTGRES_PRISMA_URL also work. Run `npm run db:migrate`,
# import the legacy document, then `npm run prisma:generate` before starting.
# Runtime queries use Prisma Client through @prisma/adapter-pg.
DATABASE_URL=

# Prisma pg adapter pool size (default 10).
PG_POOL_MAX=

# Demo credentials used by scripts/security-matrix.mjs and
# scripts/load-test-checkouts.mjs. They do not create accounts.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_KITCHEN_EMAIL=
SEED_KITCHEN_PASSWORD=
SEED_GUEST_EMAIL=
SEED_GUEST_PASSWORD=

