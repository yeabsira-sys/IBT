# Public site URL — used for metadata, sitemap and Open Graph links.
# In production this must be the public HTTPS origin, not localhost.
NEXT_PUBLIC_SITE_URL=

# Origin used as an additional same-origin check for mutations.
# In production this must match the URL users open, not localhost.
APP_ORIGIN=

API_BASE_URL=

REVALIDATE_SECRET=

# Shared Postgres (Neon, Supabase or Vercel Postgres). Required for reliable
# sign-in on Vercel; POSTGRES_URL / POSTGRES_PRISMA_URL also work.
DATABASE_URL=

# Seed accounts created the first time the database is initialised. Change these
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_KITCHEN_EMAIL=
SEED_KITCHEN_PASSWORD=
SEED_GUEST_EMAIL=
SEED_GUEST_PASSWORD=

