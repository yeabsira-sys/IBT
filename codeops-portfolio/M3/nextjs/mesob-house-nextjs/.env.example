# Public site URL — used for metadata, sitemap and Open Graph links.
# NEXT_PUBLIC_SITE_URL=https://https://addis-eats-9f08.onrender.com/
NEXT_PUBLIC_SITE_URL=http://localhost:3000

APP_ORIGIN=http://localhost:3000

# Menu backend (read on the server only).
API_BASE_URL=https://addis-eats-backend.onrender.com

# Secret for POST /api/revalidate (on-demand cache refresh). Pick any long random string.
REVALIDATE_SECRET=70453c84b40b01dd53cb772f1e467baaa8351cf0e9667c6a2ab39b0644a08fdc

# File-backed database directory. Defaults to ./.data; change it only if you
# need a writable volume (for example on a container host).
# DATA_DIR=/var/lib/mesob-house

# Seed accounts created the first time the database file is read. Change these
# before deploying anything public.
SEED_ADMIN_EMAIL=admin@mesob.house
SEED_ADMIN_PASSWORD=Admin123!
SEED_KITCHEN_EMAIL=kitchen@mesob.house
SEED_KITCHEN_PASSWORD=Kitchen123!
SEED_GUEST_EMAIL=guest@mesob.house
SEED_GUEST_PASSWORD=Guest123!

# Serve remote images without the built-in optimiser (off by default).
# IMAGES_UNOPTIMIZED=true
