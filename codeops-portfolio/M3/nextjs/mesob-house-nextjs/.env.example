# Public site URL — used for metadata, sitemap and Open Graph links.
# In production this must be the public HTTPS origin, not localhost.
NEXT_PUBLIC_SITE_URL=

# Origin used as an additional same-origin check for mutations.
# In production this must match the URL users open, not localhost.
APP_ORIGIN=

REVALIDATE_SECRET=

# Postgres (Neon, Supabase or Vercel Postgres). Required: the app has no file
# fallback. POSTGRES_URL / POSTGRES_PRISMA_URL also work.
#
# Local development:
#   npm run db:deploy   # apply Prisma Migrate migrations
#   npm run db:seed     # idempotent restaurant/catalogue/demo seed
#   npm run db:reset    # DANGER: drop and rebuild a local database only
#
# The seed refuses non-local targets unless --allow-remote is passed.
DATABASE_URL=

# Restaurant slug used by public queries and order snapshots.
MESOB_RESTAURANT_SLUG=mesob-house

# Prisma pg adapter pool size (default 10).
PG_POOL_MAX=

# Set to disable SSL for a local/private Postgres instance.
PGSSLMODE=

# Demo accounts created by scripts/seed.mjs. These are development-only.
# Passwords are hashed with the same scrypt format as the application.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_KITCHEN_EMAIL=
SEED_KITCHEN_PASSWORD=
SEED_DELIVERY_EMAIL=
SEED_DELIVERY_PASSWORD=
SEED_GUEST_EMAIL=
SEED_GUEST_PASSWORD=

# Set to true to serve remote catalogue images without Next's optimiser.
IMAGES_UNOPTIMIZED=
