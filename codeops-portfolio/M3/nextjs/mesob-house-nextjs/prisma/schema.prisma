  minSelectionsOverride Int?   @map("min_selections_override")
  maxSelectionsOverride Int?   @map("max_selections_override")

  menuItem MenuItem        @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  group    MenuOptionGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@unique([menuItemId, groupId])
  @@map("menu_item_option_groups")
}

model BranchMenuOptionAvailability {
  branchId   String   @map("branch_id") @db.Uuid
  optionId   String   @map("option_id") @db.Uuid
  isAvailable Boolean @default(true) @map("is_available")
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  branch Branch     @relation(fields: [branchId], references: [id], onDelete: Cascade)
  option MenuOption @relation(fields: [optionId], references: [id], onDelete: Cascade)

  @@id([branchId, optionId])
  @@map("branch_menu_option_availability")
}

model MenuItemPrice {
  id                  String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  menuItemId          String    @map("menu_item_id") @db.Uuid
  branchId            String?   @map("branch_id") @db.Uuid
  priceMinor          Int       @map("price_minor")
  currency            String    @default("ETB") @db.VarChar(3)
  compareAtPriceMinor Int?      @map("compare_at_price_minor")
  validFrom           DateTime  @default(now()) @map("valid_from") @db.Timestamptz(6)
  validUntil          DateTime? @map("valid_until") @db.Timestamptz(6)
  createdBy           String?   @map("created_by") @db.Uuid
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  menuItem  MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  branch    Branch?  @relation(fields: [branchId], references: [id], onDelete: Cascade)
  creator   User?    @relation("PriceCreator", fields: [createdBy], references: [id], onDelete: SetNull)

  @@index([menuItemId, branchId, validFrom])
  @@map("menu_item_prices")
}

model TaxCategory {
  id                  String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  restaurantId        String   @map("restaurant_id") @db.Uuid
  code                String
  name                String
  description         String   @default("")
  isInclusiveDefault  Boolean  @default(true) @map("is_inclusive_default")
  isActive            Boolean  @default(true) @map("is_active")
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  restaurant Restaurant  @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
