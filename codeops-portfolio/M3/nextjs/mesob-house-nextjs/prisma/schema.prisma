  centerLng     Decimal? @map("center_lng") @db.Decimal(9, 6)
  radiusMeters  Int?     @map("radius_meters")
  isActive      Boolean  @default(true) @map("is_active")
  sortOrder     Int      @default(0) @map("sort_order")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  branch Branch  @relation(fields: [branchId], references: [id], onDelete: Cascade)
  orders Order[]

  @@index([branchId, isActive, sortOrder])
  @@map("delivery_zones")
}

model BranchMenuItem {
  branchId                   String             @map("branch_id") @db.Uuid
  menuItemId                 String             @map("menu_item_id") @db.Uuid
  isEnabled                  Boolean            @default(true) @map("is_enabled")
  availabilityStatus         AvailabilityStatus @default(AVAILABLE) @map("availability_status")
  preparationTimeOverride    Int?               @map("preparation_time_override")
  temporaryUnavailableUntil  DateTime?          @map("temporary_unavailable_until") @db.Timestamptz(6)
  createdAt                  DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                  DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)

  branch   Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)
  menuItem MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Cascade)

  @@id([branchId, menuItemId])
  @@index([menuItemId])
