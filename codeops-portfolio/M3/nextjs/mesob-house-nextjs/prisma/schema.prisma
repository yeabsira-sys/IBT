model MenuItemAvailability {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  branchId       String   @map("branch_id") @db.Uuid
  menuItemId     String   @map("menu_item_id") @db.Uuid
  dayOfWeek      Int?     @map("day_of_week") @db.SmallInt
  availableFrom  String   @map("available_from") @db.VarChar(5)
  availableUntil String   @map("available_until") @db.VarChar(5)
  isAvailable    Boolean  @default(true) @map("is_available")
  validFrom      DateTime? @map("valid_from") @db.Timestamptz(6)
  validUntil     DateTime? @map("valid_until") @db.Timestamptz(6)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  branch   Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)
  menuItem MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Cascade)

  @@index([branchId, menuItemId, dayOfWeek])
  @@map("menu_item_availability")
}

model Order {
  id                   String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  publicId             String          @unique @map("public_id")
  restaurantId         String          @map("restaurant_id") @db.Uuid
  branchId             String          @map("branch_id") @db.Uuid
  userId               String          @map("user_id") @db.Uuid
  status               OrderStatus     @default(RECEIVED)
  fulfillment          FulfillmentType
  paymentMethod        String          @default("cash") @map("payment_method")
  paymentStatus        PaymentStatus   @default(PENDING) @map("payment_status")
  promotionId          String?         @map("promotion_id") @db.Uuid
  deliveryZoneId       String?         @map("delivery_zone_id") @db.Uuid
  deliveryStaffId      String?         @map("delivery_staff_id") @db.Uuid
  customerName         String          @map("customer_name")
  customerEmail        String          @map("customer_email")
  customerPhone        String          @default("") @map("customer_phone")
  contactName          String          @map("contact_name")
  contactPhone         String          @map("contact_phone")
  contactEmail         String          @map("contact_email")
  deliveryAddressLine  String          @default("") @map("delivery_address_line")
  deliveryLandmark     String          @default("") @map("delivery_landmark")
  deliveryZoneName     String          @default("") @map("delivery_zone_name")
  deliveryLatitude     Decimal?        @map("delivery_latitude") @db.Decimal(9, 6)
  deliveryLongitude    Decimal?        @map("delivery_longitude") @db.Decimal(9, 6)
  note                 String          @default("")
  scheduledFor         DateTime?       @map("scheduled_for") @db.Timestamptz(6)
  subtotalMinor        Int             @map("subtotal_minor")
  discountMinor        Int             @default(0) @map("discount_minor")
  serviceChargeMinor   Int             @default(0) @map("service_charge_minor")
  taxMinor             Int             @default(0) @map("tax_minor")
  deliveryFeeMinor     Int             @default(0) @map("delivery_fee_minor")
  totalMinor           Int?            @default(dbgenerated("GREATEST(0, ((subtotal_minor - discount_minor) + service_charge_minor) + delivery_fee_minor + (CASE WHEN tax_inclusive THEN 0 ELSE tax_minor END))")) @map("total_minor")
  currency             String          @default("ETB") @db.VarChar(3)
  taxInclusive         Boolean         @default(true) @map("tax_inclusive")
  taxRateBasisPoints   Int             @default(0) @map("tax_rate_basis_points")
  serviceChargeTaxable Boolean         @default(false) @map("service_charge_taxable")
  createdAt            DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)
  confirmedAt          DateTime?       @map("confirmed_at") @db.Timestamptz(6)
  completedAt          DateTime?       @map("completed_at") @db.Timestamptz(6)
  cancelledAt          DateTime?       @map("cancelled_at") @db.Timestamptz(6)

  restaurant    Restaurant    @relation(fields: [restaurantId], references: [id], onDelete: Restrict)
  branch        Branch        @relation(fields: [branchId], references: [id], onDelete: Restrict)
  user          User          @relation(fields: [userId], references: [id], onDelete: Restrict)
  promotion     Promotion?    @relation(fields: [promotionId], references: [id], onDelete: SetNull)
  deliveryZone  DeliveryZone? @relation(fields: [deliveryZoneId], references: [id], onDelete: SetNull)
  deliveryStaff User?         @relation("DeliveryStaffOrders", fields: [deliveryStaffId], references: [id], onDelete: SetNull)
  items         OrderItem[]
  statusHistory OrderStatusHistory[]
  reviews       Review[]
  inventoryTransactions InventoryTransaction[]

  @@index([createdAt(sort: Desc)])
  @@index([status, createdAt(sort: Desc)])
  @@index([userId, createdAt(sort: Desc)])
  @@index([branchId, status, createdAt(sort: Desc)])
  @@index([deliveryStaffId, status])
  @@map("orders")
}

model OrderItem {
  id               BigInt   @id @default(autoincrement())
  orderId          String   @map("order_id") @db.Uuid
  lineNo           Int      @map("line_no")
  menuItemId       String?  @map("menu_item_id") @db.Uuid
  menuItemSlug     String   @map("menu_item_slug")
  itemName         String   @map("item_name")
  itemDescription  String   @default("") @map("item_description")
  sku              String?
  quantity         Int
  unitPriceMinor   Int      @map("unit_price_minor")
  options          Json     @default("[]")
  substitutions    Json     @default("[]")
  allergens        Json     @default("[]")
  dietary          Json     @default("[]")
  taxMinor         Int      @default(0) @map("tax_minor")
  discountMinor    Int      @default(0) @map("discount_minor")
  lineTotalMinor   Int?     @default(dbgenerated("(unit_price_minor * quantity)")) @map("line_total_minor")

  order    Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  menuItem MenuItem? @relation(fields: [menuItemId], references: [id], onDelete: SetNull)

  @@unique([orderId, lineNo])
  @@index([menuItemId, orderId])
  @@map("order_items")
}

model OrderStatusHistory {
  id            BigInt      @id @default(autoincrement())
  orderId       String      @map("order_id") @db.Uuid
  status        OrderStatus
  changedAt     DateTime    @default(now()) @map("changed_at") @db.Timestamptz(6)
  changedBy     String?     @map("changed_by") @db.Uuid
  changedByName String      @default("") @map("changed_by_name")
  note          String?

  order         Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  changedByUser User? @relation(fields: [changedBy], references: [id], onDelete: SetNull)

  @@index([orderId, changedAt])
  @@map("order_status_history")
}

model Review {
  id         String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  menuItemId String       @map("menu_item_id") @db.Uuid
  userId     String       @map("user_id") @db.Uuid
  orderId    String?      @map("order_id") @db.Uuid
  rating     Int          @db.SmallInt
  message    String       @default("")
  status     ReviewStatus @default(APPROVED)
  createdAt  DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  menuItem MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  order    Order?   @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@unique([menuItemId, userId])
  @@index([menuItemId, status, createdAt(sort: Desc)])
  @@index([status, createdAt(sort: Desc)])
  @@map("reviews")
}

model InventoryItem {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  restaurantId String   @map("restaurant_id") @db.Uuid
  name         String
  sku          String?
  unit         Unit
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  restaurant  Restaurant              @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  branchStock BranchInventory[]
  menuItems   MenuItemInventory[]
  transactions InventoryTransaction[]
  transferLines InventoryTransferLine[]

  @@unique([restaurantId, sku])
  @@map("inventory_items")
}

model BranchInventory {
  branchId        String   @map("branch_id") @db.Uuid
  inventoryItemId String   @map("inventory_item_id") @db.Uuid
  currentStock    Decimal  @default(0) @map("current_stock") @db.Decimal(12, 3)
  minimumStock    Decimal  @default(0) @map("minimum_stock") @db.Decimal(12, 3)
  reorderLevel    Decimal  @default(0) @map("reorder_level") @db.Decimal(12, 3)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  branch        Branch        @relation(fields: [branchId], references: [id], onDelete: Cascade)
  inventoryItem InventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)

  @@id([branchId, inventoryItemId])
  @@map("branch_inventory")
}

model MenuItemInventory {
  menuItemId       String  @map("menu_item_id") @db.Uuid
  inventoryItemId  String  @map("inventory_item_id") @db.Uuid
  requiredQuantity Decimal @map("required_quantity") @db.Decimal(12, 3)
  unit             Unit

  menuItem      MenuItem      @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  inventoryItem InventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)

  @@id([menuItemId, inventoryItemId])
  @@map("menu_item_inventory")
}

model InventoryTransaction {
  id              BigInt                   @id @default(autoincrement())
  branchId        String                   @map("branch_id") @db.Uuid
  inventoryItemId String                   @map("inventory_item_id") @db.Uuid
  type            InventoryTransactionType
  quantityDelta   Decimal                  @map("quantity_delta") @db.Decimal(12, 3)
  reason          String                   @default("")
  orderId         String?                  @map("order_id") @db.Uuid
  transferId      String?                  @map("transfer_id") @db.Uuid
  actorId         String?                  @map("actor_id") @db.Uuid
  createdAt       DateTime                 @default(now()) @map("created_at") @db.Timestamptz(6)

  branch        Branch         @relation(fields: [branchId], references: [id], onDelete: Cascade)
  inventoryItem InventoryItem  @relation(fields: [inventoryItemId], references: [id], onDelete: Restrict)
  order         Order?         @relation(fields: [orderId], references: [id], onDelete: SetNull)
  transfer      InventoryTransfer? @relation(fields: [transferId], references: [id], onDelete: SetNull)
  actor         User?          @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([branchId, inventoryItemId, createdAt(sort: Desc)])
  @@index([orderId])
  @@map("inventory_transactions")
}

model InventoryTransfer {
  id           String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  fromBranchId String         @map("from_branch_id") @db.Uuid
  toBranchId   String         @map("to_branch_id") @db.Uuid
  status       TransferStatus @default(DRAFT)
  createdBy    String?        @map("created_by") @db.Uuid
  createdAt    DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  completedAt  DateTime?      @map("completed_at") @db.Timestamptz(6)

  fromBranch Branch                 @relation("TransferFrom", fields: [fromBranchId], references: [id], onDelete: Restrict)
  toBranch   Branch                 @relation("TransferTo", fields: [toBranchId], references: [id], onDelete: Restrict)
  creator    User?                  @relation(fields: [createdBy], references: [id], onDelete: SetNull)
  lines      InventoryTransferLine[]
  transactions InventoryTransaction[]

  @@index([fromBranchId, status])
  @@index([toBranchId, status])
  @@map("inventory_transfers")
}

model InventoryTransferLine {
  id              String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  transferId      String  @map("transfer_id") @db.Uuid
  inventoryItemId String  @map("inventory_item_id") @db.Uuid
  quantity        Decimal @db.Decimal(12, 3)

  transfer      InventoryTransfer @relation(fields: [transferId], references: [id], onDelete: Cascade)
  inventoryItem InventoryItem     @relation(fields: [inventoryItemId], references: [id], onDelete: Restrict)

  @@unique([transferId, inventoryItemId])
  @@map("inventory_transfer_lines")
}

model AuditLog {
  id           BigInt   @id @default(autoincrement())
  restaurantId String?  @map("restaurant_id") @db.Uuid
  branchId     String?  @map("branch_id") @db.Uuid
  entityType   String   @map("entity_type")
  entityId     String   @map("entity_id")
  action       String
  actorId      String?  @map("actor_id") @db.Uuid
  actorRole    String?  @map("actor_role")
  beforeData   Json?    @map("before_data")
  afterData    Json?    @map("after_data")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  restaurant Restaurant? @relation(fields: [restaurantId], references: [id], onDelete: SetNull)
  branch     Branch?     @relation(fields: [branchId], references: [id], onDelete: SetNull)
  actor      User?       @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId, createdAt(sort: Desc)])
  @@index([createdAt(sort: Desc)])
  @@index([branchId, createdAt(sort: Desc)])
  @@map("audit_log")
}
