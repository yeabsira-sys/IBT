generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  customer
  employee
  admin

  @@map("user_role")
}

enum OrderStatus {
  received
  preparing
  ready
  out_for_delivery
  completed
  cancelled

  @@map("order_status")
}

enum OrderFulfillment {
  pickup
  delivery

  @@map("order_fulfillment")
}

enum ReviewStatus {
  pending
  approved
  rejected

  @@map("review_status")
}

model User {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  fullName     String   @map("full_name")
  email        String
  phone        String   @unique(where: raw("(btrim(phone) <> ''::text)")) @default("")
  passwordHash String?  @map("password_hash")
  role         UserRole @default(customer)
  preference   String?
  provider     String?
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  sessions           Session[]
  orders             Order[]
  reviews            Review[]
  orderStatusHistory OrderStatusHistory[] @relation("StatusActor")
  auditLogs          AuditLog[]           @relation("AuditActor")

  @@index([role])
  @@map("users")
}

model Session {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tokenHash  String    @unique @map("token_hash")
  userId     String    @map("user_id") @db.Uuid
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt  DateTime? @map("revoked_at") @db.Timestamptz(6)
  lastSeenAt DateTime? @map("last_seen_at") @db.Timestamptz(6)
  userAgent  String?   @map("user_agent")
  ipAddress  String?   @map("ip_address")
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], map: "sessions_user_idx")
  @@index([expiresAt], map: "sessions_active_expiry_idx", where: raw("(revoked_at IS NULL)"))
  @@map("sessions")
}

model MenuCategory {
  slug        String   @id
  label       String
  description String   @default("")
  sortOrder   Int      @default(0) @map("sort_order")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  @@index([isActive, sortOrder], map: "menu_categories_active_idx")
  @@map("menu_categories")
}

model MenuItem {
  id               String   @id
  name             String
  nativeName       String   @default("") @map("native_name")
  tagline          String   @default("")
  description      String   @default("")
  longDescription  String   @default("") @map("long_description")
  category         String   @default("menu")
  priceCents       Int      @map("price_cents")
  imageUrl         String   @default("") @map("image_url")
  spiceLevel       String   @default("") @map("spice_level")
  servings         String   @default("")
  ingredients      String[] @default([])
  allergens        String[] @default([])
  tags             String[] @default([])
  badgeText        String   @default("") @map("badge_text")
  badgeTone        String   @default("brand") @map("badge_tone")
  isSpecial        Boolean  @default(false) @map("is_special")
  isActive         Boolean  @default(true) @map("is_active")
  isFasting        Boolean  @default(false) @map("is_fasting")
  isComplimentary  Boolean  @default(false) @map("is_complimentary")
  isSide           Boolean  @default(false) @map("is_side")
  sortOrder        Int      @default(0) @map("sort_order")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  orderItems   OrderItem[]
  optionGroups MenuOptionGroup[]
  pairings     MenuPairing[]     @relation("MenuPairings")
  pairedBy     MenuPairing[]     @relation("PairedBy")
  reviews      Review[]

  @@index([category, isActive], map: "menu_items_category_idx")
  @@index([category, isActive, sortOrder], map: "menu_items_category_order_idx")
  @@index([isActive, isSpecial, sortOrder], map: "menu_items_active_special_idx")
  @@map("menu_items")
}

model MenuOptionGroup {
  id            String   @id
  menuItemId    String   @map("menu_item_id")
  key           String
  title         String
  icon          String   @default("")
  badge         String   @default("")
  columns       Int      @default(1)
  isMulti       Boolean  @default(false) @map("is_multi")
  maxSelections Int      @default(1) @map("max_selections")
  sortOrder     Int      @default(0) @map("sort_order")
  isActive      Boolean  @default(true) @map("is_active")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  menuItem MenuItem     @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  options  MenuOption[]

  @@unique([menuItemId, key], map: "menu_option_groups_menu_item_id_key_key")
  @@index([menuItemId, isActive, sortOrder], map: "menu_option_groups_item_idx")
  @@map("menu_option_groups")
}

model MenuOption {
  id              String   @id
  groupId         String   @map("group_id")
  value           String
  title           String
  description     String   @default("")
  note            String   @default("")
  priceDeltaCents Int      @default(0) @map("price_delta_cents")
  isDefault       Boolean  @default(false) @map("is_default")
  isActive        Boolean  @default(true) @map("is_active")
  sortOrder       Int      @default(0) @map("sort_order")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  group MenuOptionGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@unique([groupId, value], map: "menu_options_group_id_value_key")
  @@index([groupId, isActive, sortOrder], map: "menu_options_group_idx")
  @@map("menu_options")
}

model MenuPairing {
  menuItemId       String @map("menu_item_id")
  pairedMenuItemId String @map("paired_menu_item_id")
  sortOrder        Int    @default(0) @map("sort_order")

  menuItem   MenuItem @relation("MenuPairings", fields: [menuItemId], references: [id], onDelete: Cascade)
  pairedItem MenuItem @relation("PairedBy", fields: [pairedMenuItemId], references: [id], onDelete: Cascade)

  @@id([menuItemId, pairedMenuItemId])
  @@index([menuItemId, sortOrder], map: "menu_pairings_item_idx")
  @@map("menu_pairings")
}

model Review {
  id         String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  menuItemId String       @map("menu_item_id")
  userId     String       @map("user_id") @db.Uuid
  orderId    String?      @map("order_id")
  rating     Int          @db.SmallInt
  message    String       @default("")
  status     ReviewStatus @default(approved)
  createdAt  DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime     @default(now()) @map("updated_at") @db.Timestamptz(6)

  menuItem MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  order    Order?   @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@unique([menuItemId, userId], map: "reviews_menu_item_id_user_id_key")
  @@index([menuItemId, status, createdAt(sort: Desc)], map: "reviews_menu_status_idx")
  @@index([status, createdAt(sort: Desc)], map: "reviews_status_idx")
  @@index([userId, createdAt(sort: Desc)], map: "reviews_user_idx")
  @@index([orderId], map: "reviews_order_idx")
  @@map("reviews")
}

model Order {
  id               String           @id
  userId           String           @map("user_id") @db.Uuid
  status           OrderStatus      @default(received)
  fulfillment      OrderFulfillment
  customerName     String           @map("customer_name")
  customerEmail    String           @map("customer_email")
  customerPhone    String           @default("") @map("customer_phone")
  contactName      String           @map("contact_name")
  contactPhone     String           @map("contact_phone")
  contactEmail     String           @map("contact_email")
  deliverySubCity  String           @default("") @map("delivery_sub_city")
  deliveryStreet   String           @default("") @map("delivery_street")
  deliveryLandmark String           @default("") @map("delivery_landmark")
  deliveryTiming   String           @default("immediate") @map("delivery_timing")
  paymentMethod    String           @map("payment_method")
  couponCode       String?          @map("coupon_code")
  note             String           @default("")
  subtotalCents    Int              @map("subtotal_cents")
  injeraCents      Int              @default(0) @map("injera_cents")
  packagingCents   Int              @default(0) @map("packaging_cents")
  vatCents         Int              @default(0) @map("vat_cents")
  discountCents    Int              @default(0) @map("discount_cents")
  totalCents       Int?             @default(dbgenerated("GREATEST(0, ((((subtotal_cents + injera_cents) + packaging_cents) + vat_cents) - discount_cents))")) @map("total_cents")
  createdAt        DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime         @default(now()) @map("updated_at") @db.Timestamptz(6)

  user          User                 @relation(fields: [userId], references: [id], onDelete: Restrict)
  items         OrderItem[]
  statusHistory OrderStatusHistory[]
  reviews       Review[]

  @@index([createdAt(sort: Desc)], map: "orders_created_at_idx")
  @@index([status, createdAt(sort: Desc)], map: "orders_status_created_at_idx")
  @@index([userId, createdAt(sort: Desc)], map: "orders_user_created_at_idx")
  @@index([createdAt], map: "orders_live_queue_idx", where: raw("(status = ANY (ARRAY['received'::order_status, 'preparing'::order_status, 'ready'::order_status, 'out_for_delivery'::order_status]))"))
  @@index([fulfillment, deliverySubCity, totalCents], map: "orders_completed_area_cover_idx", where: raw("(status = 'completed'::order_status)"))
  @@index([userId, totalCents], map: "orders_completed_user_cover_idx", where: raw("(status = 'completed'::order_status)"))
  @@map("orders")
}

model OrderItem {
  id             BigInt @id @default(autoincrement())
  orderId        String @map("order_id")
  lineNo         Int    @map("line_no")
  menuItemId     String @map("menu_item_id")
  itemName       String @map("item_name")
  unitPriceCents Int    @map("unit_price_cents")
  quantity       Int
  lineTotalCents Int?   @default(dbgenerated("(unit_price_cents * quantity)")) @map("line_total_cents")

  order    Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  menuItem MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Restrict)

  @@unique([orderId, lineNo], map: "order_items_order_id_line_no_key")
  @@index([menuItemId, orderId], map: "order_items_menu_item_idx")
  @@index([menuItemId, orderId, quantity, unitPriceCents], map: "order_items_menu_completed_idx")
  @@map("order_items")
}

model OrderStatusHistory {
  id            BigInt      @id @default(autoincrement())
  orderId       String      @map("order_id")
  status        OrderStatus
  changedAt     DateTime    @default(now()) @map("changed_at") @db.Timestamptz(6)
  changedBy     String?     @map("changed_by") @db.Uuid
  changedByName String      @default("") @map("changed_by_name")
  note          String?

  order         Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  changedByUser User? @relation("StatusActor", fields: [changedBy], references: [id], onDelete: SetNull)

  @@unique([orderId, status, changedAt], map: "order_status_history_order_id_status_changed_at_key")
  @@index([orderId, changedAt], map: "order_status_history_order_idx")
  @@index([orderId, changedAt(sort: Desc)], map: "order_status_history_recent_idx")
  @@map("order_status_history")
}

model AuditLog {
  id         BigInt   @id @default(autoincrement())
  entityType String   @map("entity_type")
  entityId   String   @map("entity_id")
  action     String
  actorId    String?  @map("actor_id") @db.Uuid
  actorRole  String?  @map("actor_role")
  beforeData Json?    @map("before_data")
  afterData  Json?    @map("after_data")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  actor User? @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId, createdAt(sort: Desc)], map: "audit_log_entity_idx")
  @@index([createdAt(sort: Desc)], map: "audit_log_created_idx")
  @@map("audit_log")
}
