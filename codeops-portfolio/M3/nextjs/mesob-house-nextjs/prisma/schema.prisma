}

model TaxRate {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  taxCategoryId  String    @map("tax_category_id") @db.Uuid
  rateBasisPoints Int      @map("rate_basis_points")
  validFrom      DateTime  @default(now()) @map("valid_from") @db.Timestamptz(6)
  validUntil     DateTime? @map("valid_until") @db.Timestamptz(6)
  createdBy      String?   @map("created_by") @db.Uuid
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  taxCategory TaxCategory @relation(fields: [taxCategoryId], references: [id], onDelete: Cascade)
  creator     User?       @relation("TaxCreator", fields: [createdBy], references: [id], onDelete: SetNull)

  @@index([taxCategoryId, validFrom])
  @@map("tax_rates")
}

model Promotion {
  id               String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  restaurantId     String         @map("restaurant_id") @db.Uuid
  branchId         String?        @map("branch_id") @db.Uuid
  code             String?
  name             String
  description      String         @default("")
  scope            PromotionScope
  type             PromotionType
  value            Int
  minOrderMinor    Int            @default(0) @map("min_order_minor")
  maxDiscountMinor Int?           @map("max_discount_minor")
  startsAt         DateTime       @map("starts_at") @db.Timestamptz(6)
  endsAt           DateTime?      @map("ends_at") @db.Timestamptz(6)
  isActive         Boolean        @default(true) @map("is_active")
  priority         Int            @default(0)
  createdAt        DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  branch     Branch?    @relation(fields: [branchId], references: [id], onDelete: Cascade)
  orders     Order[]

  @@unique([restaurantId, code])
  @@index([restaurantId, isActive, startsAt, endsAt])
  @@map("promotions")
}

model DeliveryZone {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  branchId      String   @map("branch_id") @db.Uuid
  name          String
  description   String   @default("")
  baseFeeMinor  Int      @map("base_fee_minor")
