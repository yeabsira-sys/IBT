generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum AccountType {
  CUSTOMER
  STAFF

  @@map("account_type")
}

enum StaffRole {
  RESTAURANT_OWNER
  SUPER_ADMIN
  RESTAURANT_MANAGER
  BRANCH_MANAGER
  CASHIER
  KITCHEN_STAFF
  INVENTORY_MANAGER
  DELIVERY_STAFF

  @@map("staff_role")
}

enum RestaurantStatus {
  ACTIVE
  INACTIVE
  SUSPENDED

  @@map("restaurant_status")
}

enum BranchStatus {
  ACTIVE
  INACTIVE

  @@map("branch_status")
}

enum MenuType {
  ALL_DAY
  BREAKFAST
  LUNCH
  DINNER
  DRINKS
  DESSERTS
  SEASONAL
  SPECIAL

  @@map("menu_type")
}

enum ServingTemperature {
  HOT
  COLD
  ROOM_TEMPERATURE

  @@map("serving_temperature")
}

enum DifficultyLevel {
  EASY
  MEDIUM
  HARD

  @@map("difficulty_level")
}

enum SpiceLevel {
  NONE
  MILD
  MEDIUM
  HOT
  EXTRA_HOT

  @@map("spice_level")
}

enum Unit {
  G
  KG
  ML
  L
  PIECE
  TBSP
  TSP
  CUP
  PORTION

  @@map("unit")
}

enum MediaType {
  IMAGE
  VIDEO

  @@map("media_type")
}

enum AllergenSource {
  INGREDIENT
  CROSS_CONTACT

  @@map("allergen_source")
}

enum VerificationStatus {
  UNVERIFIED
  VERIFIED
  REJECTED

  @@map("verification_status")
}

enum NutritionSource {
  LAB_TESTED
  CALCULATED
  MANUFACTURER
  ESTIMATED

  @@map("nutrition_source")
}

enum PairingType {
  RECOMMENDED
  DRINK
  SIDE
  DESSERT
  RELATED

  @@map("pairing_type")
}

enum SelectionType {
  SINGLE
  MULTIPLE

  @@map("selection_type")
}

enum DisplayType {
  RADIO
  CHECKBOX
  DROPDOWN
  BUTTON

  @@map("display_type")
}

enum AvailabilityStatus {
  AVAILABLE
  OUT_OF_STOCK
  TEMPORARILY_UNAVAILABLE
  DISCONTINUED

  @@map("availability_status")
}

enum ServiceChargeType {
  NONE
  PERCENTAGE
  FIXED

  @@map("service_charge_type")
}

enum PromotionScope {
  RESTAURANT
  BRANCH

  @@map("promotion_scope")
}

enum PromotionType {
  PERCENTAGE
  FIXED

  @@map("promotion_type")
}

enum OrderStatus {
  RECEIVED
  PREPARING
  READY
  OUT_FOR_DELIVERY
  COMPLETED
  CANCELLED

  @@map("order_status")
}

enum FulfillmentType {
  DELIVERY
  PICKUP

  @@map("fulfillment_type")
}

enum PaymentStatus {
  PENDING
  PAID
  REFUNDED
  CANCELLED

  @@map("payment_status")
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED

  @@map("review_status")
}

enum InventoryTransactionType {
  PURCHASE
  DEDUCTION
  ADJUSTMENT
  TRANSFER_OUT
  TRANSFER_IN

  @@map("inventory_transaction_type")
}

enum TransferStatus {
  DRAFT
  IN_TRANSIT
  COMPLETED
  CANCELLED

  @@map("transfer_status")
}

model Restaurant {
  id                 String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name               String
  slug               String           @unique
  legalName          String?          @map("legal_name")
  description        String           @default("")
  logoUrl            String           @default("") @map("logo_url")
  phone              String           @default("")
  email              String           @default("")
  address            String           @default("")
  timezone           String           @default("Africa/Addis_Ababa")
  defaultLocale      String           @default("en") @map("default_locale")
  defaultCurrency    String           @default("ETB") @db.VarChar(3) @map("default_currency")
  defaultTaxInclusive Boolean         @default(true) @map("default_tax_inclusive")
  status             RestaurantStatus @default(ACTIVE)
  createdAt          DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  branches       Branch[]
  menus          Menu[]
  menuItems      MenuItem[]
  ingredients    Ingredient[]
  optionGroups   MenuOptionGroup[]
  taxCategories  TaxCategory[]
  promotions     Promotion[]
  inventoryItems InventoryItem[]
  roleAssignments RoleAssignment[]
  orders         Order[]
  auditLogs      AuditLog[]

  @@map("restaurants")
}

model Branch {
  id                  String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  restaurantId        String             @map("restaurant_id") @db.Uuid
  name                String
  slug                String
  address             String             @default("")
  latitude            Decimal?           @db.Decimal(9, 6)
  longitude           Decimal?           @db.Decimal(9, 6)
  phone               String             @default("")
  timezone            String?
  status              BranchStatus       @default(ACTIVE)
  isDefault           Boolean            @default(false) @map("is_default")
  serviceChargeType   ServiceChargeType  @default(NONE) @map("service_charge_type")
  serviceChargeValue  Int                @default(0) @map("service_charge_value")
  serviceChargeTaxable Boolean           @default(false) @map("service_charge_taxable")
  menuVersion         Int                @default(1) @map("menu_version")
  createdAt           DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)

  restaurant          Restaurant          @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  operatingHours      BranchOperatingHours[]
  menuItems           BranchMenuItem[]
  availability        MenuItemAvailability[]
  optionAvailability  BranchMenuOptionAvailability[]
  deliveryZones       DeliveryZone[]
  priceOverrides      MenuItemPrice[]
  promotions          Promotion[]
  roleAssignments     RoleAssignment[]
  orders              Order[]
  inventory           BranchInventory[]
  inventoryTransactions InventoryTransaction[]
  inventoryTransfersFrom InventoryTransfer[] @relation("TransferFrom")
  inventoryTransfersTo   InventoryTransfer[] @relation("TransferTo")
  auditLogs           AuditLog[]
  menuPublications    MenuPublication[]

  @@unique([restaurantId, slug])
  @@index([restaurantId, status])
  @@map("branches")
}

model BranchOperatingHours {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  branchId  String   @map("branch_id") @db.Uuid
  dayOfWeek Int      @map("day_of_week") @db.SmallInt
  opensAt   String   @map("opens_at") @db.VarChar(5)
  closesAt  String   @map("closes_at") @db.VarChar(5)
  isClosed  Boolean  @default(false) @map("is_closed")
  branch    Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@index([branchId, dayOfWeek])
  @@map("branch_operating_hours")
}

model MenuPublication {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  branchId      String   @map("branch_id") @db.Uuid
  version       Int
  publishedBy   String?  @map("published_by") @db.Uuid
  publishedAt   DateTime @default(now()) @map("published_at") @db.Timestamptz(6)
  note          String   @default("")
  branch        Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)
  publishedByUser User?  @relation("MenuPublisher", fields: [publishedBy], references: [id], onDelete: SetNull)

  @@unique([branchId, version])
  @@map("menu_publications")
}

model User {
  id           String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  fullName     String      @map("full_name")
  email        String      @unique
  phone        String?     @unique
  passwordHash String?     @map("password_hash")
  accountType  AccountType @default(CUSTOMER) @map("account_type")
  preference   String?
  provider     String?
  createdAt    DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime    @updatedAt @map("updated_at") @db.Timestamptz(6)

  sessions         Session[]
  orders           Order[]
  deliveryOrders   Order[]              @relation("DeliveryStaffOrders")
  reviews          Review[]
  statusHistory    OrderStatusHistory[]
  roleAssignments  RoleAssignment[]
  createdPrices    MenuItemPrice[]      @relation("PriceCreator")
  createdTaxRates  TaxRate[]            @relation("TaxCreator")
  inventoryTransactions InventoryTransaction[]
  inventoryTransfers InventoryTransfer[]
  auditLogs        AuditLog[]
  menuPublications MenuPublication[]    @relation("MenuPublisher")

  @@index([accountType])
  @@map("users")
}

model Session {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tokenHash  String    @unique @map("token_hash")
  userId     String    @map("user_id") @db.Uuid
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt  DateTime? @map("revoked_at") @db.Timestamptz(6)
  lastSeenAt DateTime? @map("last_seen_at") @db.Timestamptz(6)
  userAgent  String?   @map("user_agent")
  ipAddress  String?   @map("ip_address")
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

model RoleAssignment {
  id           String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId       String     @map("user_id") @db.Uuid
  role         StaffRole
  restaurantId String     @map("restaurant_id") @db.Uuid
  branchId     String?    @map("branch_id") @db.Uuid
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  branch     Branch?    @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@unique([userId, role, restaurantId, branchId])
  @@index([restaurantId, role])
  @@index([branchId, role])
  @@map("role_assignments")
}

model Menu {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  restaurantId String   @map("restaurant_id") @db.Uuid
  name         String
  slug         String
  description  String   @default("")
  type         MenuType @default(ALL_DAY)
  isActive     Boolean  @default(true) @map("is_active")
  validFrom    DateTime? @map("valid_from") @db.Timestamptz(6)
  validUntil   DateTime? @map("valid_until") @db.Timestamptz(6)
  sortOrder    Int      @default(0) @map("sort_order")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  restaurant Restaurant   @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  categories MenuCategory[]

  @@unique([restaurantId, slug])
  @@index([restaurantId, isActive])
  @@map("menus")
}

model MenuCategory {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  menuId      String   @map("menu_id") @db.Uuid
  parentId    String?  @map("parent_id") @db.Uuid
  name        String
  slug        String
  description String   @default("")
  imageUrl    String   @default("") @map("image_url")
  sortOrder   Int      @default(0) @map("sort_order")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  menu      Menu           @relation(fields: [menuId], references: [id], onDelete: Cascade)
  parent    MenuCategory?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children  MenuCategory[] @relation("CategoryTree")
  menuItems MenuItemCategory[]

  @@unique([menuId, slug])
  @@index([menuId, parentId, sortOrder])
  @@map("menu_categories")
}

model MenuItem {
  id                  String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  restaurantId        String             @map("restaurant_id") @db.Uuid
  sku                 String?
  slug                String
  name                String
  nativeName          String             @default("") @map("native_name")
  shortDescription    String             @default("") @map("short_description")
  description         String             @default("")
  searchKeywords      String[]           @default([]) @map("search_keywords")
  sortOrder           Int                @default(0) @map("sort_order")
  spiceLevel          SpiceLevel?        @map("spice_level")
  spiceNotes          String             @default("") @map("spice_notes")
  isSpecial           Boolean            @default(false) @map("is_special")
  preparationTimeMinutes Int?            @map("preparation_time_minutes")
  cookingTimeMinutes  Int?               @map("cooking_time_minutes")
  preparationMethods  String[]           @default([]) @map("preparation_methods")
  preparationNotes    String             @default("") @map("preparation_notes")
  servingSize         Decimal?           @map("serving_size") @db.Decimal(10, 3)
  servingUnit         Unit?              @map("serving_unit")
  servingTemperature  ServingTemperature? @map("serving_temperature")
  servingNotes        String             @default("") @map("serving_notes")
  difficultyLevel     DifficultyLevel?   @map("difficulty_level")
  basePriceMinor      Int                @map("base_price_minor")
  currency            String             @default("ETB") @db.VarChar(3)
  compareAtPriceMinor Int?               @map("compare_at_price_minor")
  costPriceMinor      Int?               @map("cost_price_minor")
  taxCategoryId       String?            @map("tax_category_id") @db.Uuid
  isTaxInclusive      Boolean            @default(true) @map("is_tax_inclusive")
  serviceChargeApplicable Boolean        @default(true) @map("service_charge_applicable")
  badgeText           String             @default("") @map("badge_text")
  badgeTone           String             @default("brand") @map("badge_tone")
  deletedAt           DateTime?          @map("deleted_at") @db.Timestamptz(6)
  createdAt           DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)

  restaurant        Restaurant        @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  taxCategory       TaxCategory?      @relation(fields: [taxCategoryId], references: [id], onDelete: SetNull)
  translations      MenuItemTranslation[]
  categories        MenuItemCategory[]
  ingredients       MenuItemIngredient[]
  allergens         MenuItemAllergen[]
  dietaryAttributes MenuItemDietaryAttribute[]
  nutrition         Nutrition?
  media             MenuItemMedia[]
  prices            MenuItemPrice[]
  pairings          MenuPairing[]     @relation("MenuPairings")
  pairedBy          MenuPairing[]     @relation("PairedBy")
  optionGroups      MenuItemOptionGroup[]
  branchItems       BranchMenuItem[]
  availability      MenuItemAvailability[]
  reviews           Review[]
  orderItems        OrderItem[]
  inventoryLinks    MenuItemInventory[]

  @@unique([restaurantId, slug])
  @@unique([restaurantId, sku])
  @@index([restaurantId, deletedAt])
  @@index([restaurantId, isSpecial, sortOrder])
  @@index([restaurantId, basePriceMinor])
  @@map("menu_items")
}

model MenuItemTranslation {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  menuItemId       String   @map("menu_item_id") @db.Uuid
  locale           String
  name             String
  shortDescription String   @default("") @map("short_description")
  description      String   @default("")
  nativeName       String   @default("") @map("native_name")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  menuItem MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Cascade)

  @@unique([menuItemId, locale])
  @@map("menu_item_translations")
}

model MenuItemCategory {
  menuItemId String @map("menu_item_id") @db.Uuid
  categoryId String @map("category_id") @db.Uuid
  sortOrder  Int    @default(0) @map("sort_order")

  menuItem MenuItem     @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  category MenuCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([menuItemId, categoryId])
  @@index([categoryId, sortOrder])
  @@map("menu_item_categories")
}

model Ingredient {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  restaurantId String  @map("restaurant_id") @db.Uuid
  name        String
  slug        String
  description String   @default("")
  defaultUnit Unit @map("default_unit")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  restaurant Restaurant          @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  menuItems  MenuItemIngredient[]

  @@unique([restaurantId, slug])
  @@map("ingredients")
}

model MenuItemIngredient {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  menuItemId       String   @map("menu_item_id") @db.Uuid
  ingredientId     String   @map("ingredient_id") @db.Uuid
  quantity         Decimal? @db.Decimal(10, 3)
  unit             Unit
  isOptional       Boolean  @default(false) @map("is_optional")
  isSubstitutable  Boolean  @default(false) @map("is_substitutable")
  preparationNote  String   @default("") @map("preparation_note")
  sortOrder        Int      @default(0) @map("sort_order")

  menuItem   MenuItem   @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  ingredient Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Restrict)

  @@unique([menuItemId, ingredientId])
  @@map("menu_item_ingredients")
}

model Allergen {
  id          String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code        String @unique
  name        String
  description String @default("")

  menuItems MenuItemAllergen[]

  @@map("allergens")
}

model MenuItemAllergen {
  id         String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  menuItemId String         @map("menu_item_id") @db.Uuid
  allergenId String         @map("allergen_id") @db.Uuid
  source     AllergenSource @default(INGREDIENT)
  isConfirmed Boolean       @default(false) @map("is_confirmed")
  notes      String         @default("")

  menuItem MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  allergen Allergen @relation(fields: [allergenId], references: [id], onDelete: Restrict)

  @@unique([menuItemId, allergenId, source])
  @@index([allergenId, isConfirmed])
  @@map("menu_item_allergens")
}

model DietaryAttribute {
  id          String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code        String @unique
  name        String
  description String @default("")

  menuItems MenuItemDietaryAttribute[]

  @@map("dietary_attributes")
}

model MenuItemDietaryAttribute {
  id                 String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  menuItemId         String             @map("menu_item_id") @db.Uuid
  dietaryAttributeId String             @map("dietary_attribute_id") @db.Uuid
  verificationStatus VerificationStatus @default(UNVERIFIED) @map("verification_status")
  verifiedAt         DateTime?          @map("verified_at") @db.Timestamptz(6)
  verifiedBy         String?            @map("verified_by") @db.Uuid

  menuItem         MenuItem         @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  dietaryAttribute DietaryAttribute @relation(fields: [dietaryAttributeId], references: [id], onDelete: Restrict)

  @@unique([menuItemId, dietaryAttributeId])
  @@index([dietaryAttributeId, verificationStatus])
  @@map("menu_item_dietary_attributes")
}

model Nutrition {
  id                 String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  menuItemId         String          @unique @map("menu_item_id") @db.Uuid
  servingSize        Decimal         @map("serving_size") @db.Decimal(10, 3)
  servingUnit        Unit            @map("serving_unit")
  caloriesKcal       Int?            @map("calories_kcal")
  energyKj           Int?            @map("energy_kj")
  proteinG           Decimal?        @map("protein_g") @db.Decimal(10, 3)
  carbohydratesG     Decimal?        @map("carbohydrates_g") @db.Decimal(10, 3)
  sugarsG            Decimal?        @map("sugars_g") @db.Decimal(10, 3)
  addedSugarsG       Decimal?        @map("added_sugars_g") @db.Decimal(10, 3)
  totalFatG          Decimal?        @map("total_fat_g") @db.Decimal(10, 3)
  saturatedFatG      Decimal?        @map("saturated_fat_g") @db.Decimal(10, 3)
  transFatG          Decimal?        @map("trans_fat_g") @db.Decimal(10, 3)
  fiberG             Decimal?        @map("fiber_g") @db.Decimal(10, 3)
  sodiumMg           Decimal?        @map("sodium_mg") @db.Decimal(10, 3)
  cholesterolMg      Decimal?        @map("cholesterol_mg") @db.Decimal(10, 3)
  nutritionSource    NutritionSource @map("nutrition_source")
  nutritionVerifiedAt DateTime?      @map("nutrition_verified_at") @db.Timestamptz(6)
  verifiedBy         String?         @map("verified_by") @db.Uuid
  createdAt          DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)

  menuItem MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Cascade)

  @@map("nutrition")
}

model MenuItemMedia {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  menuItemId String    @map("menu_item_id") @db.Uuid
  url        String
  altText    String    @default("") @map("alt_text")
  mediaType  MediaType @default(IMAGE) @map("media_type")
  width      Int?
  height     Int?
  isPrimary  Boolean   @default(false) @map("is_primary")
  sortOrder  Int       @default(0) @map("sort_order")
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  menuItem MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Cascade)

  @@index([menuItemId, sortOrder])
  @@map("menu_item_media")
}

model MenuPairing {
  id               String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  menuItemId       String      @map("menu_item_id") @db.Uuid
  pairedMenuItemId String      @map("paired_menu_item_id") @db.Uuid
  type             PairingType @default(RECOMMENDED)
  sortOrder        Int         @default(0) @map("sort_order")

  menuItem   MenuItem @relation("MenuPairings", fields: [menuItemId], references: [id], onDelete: Cascade)
  pairedItem MenuItem @relation("PairedBy", fields: [pairedMenuItemId], references: [id], onDelete: Cascade)

  @@unique([menuItemId, pairedMenuItemId])
  @@index([menuItemId, sortOrder])
  @@map("menu_pairings")
}

model MenuOptionGroup {
  id            String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  restaurantId  String        @map("restaurant_id") @db.Uuid
  key           String
  title         String
  description   String        @default("")
  isRequired    Boolean       @default(false) @map("is_required")
  selectionType SelectionType @map("selection_type")
  minSelections Int           @default(0) @map("min_selections")
  maxSelections Int           @default(1) @map("max_selections")
  displayType   DisplayType   @default(RADIO) @map("display_type")
  sortOrder     Int           @default(0) @map("sort_order")
  isActive      Boolean       @default(true) @map("is_active")
  deletedAt     DateTime?     @map("deleted_at") @db.Timestamptz(6)
  createdAt     DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  restaurant Restaurant          @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  options    MenuOption[]
  menuItems  MenuItemOptionGroup[]

  @@unique([restaurantId, key])
  @@index([restaurantId, isActive, sortOrder])
  @@map("menu_option_groups")
}

model MenuOption {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  groupId         String   @map("group_id") @db.Uuid
  value           String
  title           String
  description     String   @default("")
  note            String   @default("")
  priceDeltaMinor Int      @default(0) @map("price_delta_minor")
  isDefault       Boolean  @default(false) @map("is_default")
  isActive        Boolean  @default(true) @map("is_active")
  maxQuantity     Int      @default(1) @map("max_quantity")
  sortOrder       Int      @default(0) @map("sort_order")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  group             MenuOptionGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  branchAvailability BranchMenuOptionAvailability[]

  @@unique([groupId, value])
  @@index([groupId, isActive, sortOrder])
  @@map("menu_options")
}

model MenuItemOptionGroup {
  id                   String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  menuItemId           String  @map("menu_item_id") @db.Uuid
  groupId              String  @map("group_id") @db.Uuid
  sortOrder            Int     @default(0) @map("sort_order")
